# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Groq — turns the natural-language question into SQL.
# Create a key at https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# Optional. Any Groq chat model that supports strict structured outputs.
# Default: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Optional. Reasoning effort for gpt-oss models: low | medium | high.
# "low" uses far fewer tokens of the Groq quota. Default: low
# GROQ_REASONING_EFFORT=low

# Optional. Output token cap per Groq call (256–4096). Default: 1024
# GROQ_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# WCA OAuth — the Statistics API only runs queries for a signed-in WCA user.
# Register an application at
# https://www.worldcubeassociation.org/oauth/applications
#   Redirect URI: must match WCA_OAUTH_REDIRECT_URI below, exactly
#   Scopes:       public
# ---------------------------------------------------------------------------
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=

# Must be identical to the redirect URI registered on the WCA application.
# When unset, the current origin + /api/auth/callback is used, which is
# convenient locally but will not match a registered production application.
WCA_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional. Space-separated OAuth scopes. `public` is all this app needs.
# WCA_OAUTH_SCOPE=public

# Optional. Point at the WCA staging environment for testing.
# WCA_BASE_URL=https://www.worldcubeassociation.org

# Optional. The Statistics API that executes the SQL.
# WCA_STATISTICS_API_URL=https://statistics-api.worldcubeassociation.org

# ---------------------------------------------------------------------------
# Session — encrypts the HttpOnly cookie holding the WCA access token.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Rows requested per page. The WCA Statistics API caps this at 100.
# RESULTS_PAGE_SIZE=25
